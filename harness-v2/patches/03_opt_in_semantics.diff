+    def quality(self):
+        goal = self.text("goal.txt", "goal\n")
+        return goal, self.save("quality", {"schema": "research_quality.v1", "kind": "risk_cap_return_v1",
+                                           "drawdown_ceiling": 0.2, "annual_path": "annual", "drawdown_path": "mdd",
