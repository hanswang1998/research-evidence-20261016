@@ -0,0 +1,157 @@
+#!/usr/bin/env python3
+"""Compare two scheduler policies or harness versions on real, interleaved batches.
+
+Offline replay can only score paths that were actually recorded. Because research
+here is cheap (an account job takes minutes), the more direct test is to run the
+incumbent and the candidate on alternating real batches and compare outcome rates.
+
+Each arm is a list of closed batch directories (BATCH.json, D*.json, O*.json).
+Outcomes use the canonical categories of research_outcomes.py. The primary
+success measure is ``improvement``; when observations carry a walk-forward verdict
+(``walkforward`` reference written by observe) it is ``validated``, i.e. an
+improvement whose walk-forward verdict is also ``pass``.
+The secondary guard is the no-verdict share (engineering failures + evidence gaps).
+
+Decision rule (frozen in --rule or defaults):
+  insufficient_data  either arm has fewer than min_decisions observations
+  prefer_candidate   success-rate difference lower bound > 0, the no-verdict share
+                     did not rise by more than max_no_verdict_increase (point
+                     estimate), and no rise in it is statistically detected
+  prefer_incumbent   success-rate difference upper bound < 0
+  no_difference      otherwise
+Intervals are Newcombe hybrid score intervals built from Wilson intervals.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import statistics
+import sys
+from datetime import datetime
+from pathlib import Path
+
+STATUS_TO_CATEGORY = {"valid_improvement": "improvement", "valid_negative": "negative",
+                      "verified_information": "information", "implementation_error": "engineering_failure",
+                      "evidence_gap": "evidence_gap"}
+NO_VERDICT = {"engineering_failure", "evidence_gap"}
+DEFAULT_RULE = {"min_decisions": 30, "confidence": 0.9, "max_no_verdict_increase": 0.05}
+Z = {0.8: 1.2816, 0.9: 1.6449, 0.95: 1.96}
+
+
+def read(path):
+    return json.loads(Path(path).read_text(encoding="utf-8-sig"))
+
+
+def wilson(successes, trials, z):
+    if trials == 0:
+        return 0.0, 1.0
+    p = successes / trials
+    denominator = 1 + z * z / trials
+    centre = (p + z * z / (2 * trials)) / denominator
+    margin = z * math.sqrt(p * (1 - p) / trials + z * z / (4 * trials * trials)) / denominator
+    return max(0.0, centre - margin), min(1.0, centre + margin)
+
+
+def newcombe(x1, n1, x2, n2, z):
+    """Interval for p1 - p2 (candidate minus incumbent)."""
+    p1, p2 = x1 / n1, x2 / n2
+    l1, u1 = wilson(x1, n1, z)
+    l2, u2 = wilson(x2, n2, z)
+    d = p1 - p2
+    return d - math.sqrt((p1 - l1) ** 2 + (u2 - p2) ** 2), d + math.sqrt((u1 - p1) ** 2 + (p2 - l2) ** 2)
+
+
+def walkforward_pass(observation):
+    ref = observation.get("walkforward")
+    if not ref:
+        return None
+    verdict = read(ref["path"])
+    return verdict.get("decision") == "pass"
+
+
+def arm_summary(directories):
+    rows, minutes, policies, harnesses = [], [], set(), set()
+    for directory in directories:
+        directory = Path(directory)
+        batch = read(directory / "BATCH.json")
+        policies.add(batch["policy"]["id"])
+        if batch.get("harness_deployment"):
+            harnesses.add(batch["harness_deployment"]["bundle"]["sha256"])
+        for outcome_path in sorted(directory.glob("O*.json")):
+            outcome = read(outcome_path)
+            decision = read(directory / ("D" + outcome_path.name[1:]))
+            category = STATUS_TO_CATEGORY.get(outcome["observation"]["status"], "unclassified")
+            rows.append({"category": category, "validated": walkforward_pass(outcome)})
+            started = datetime.fromisoformat(decision["at"].replace("Z", "+00:00"))
+            finished = datetime.fromisoformat(outcome["at"].replace("Z", "+00:00"))
+            minutes.append((finished - started).total_seconds() / 60)
+    counts = {}
+    for row in rows:
+        counts[row["category"]] = counts.get(row["category"], 0) + 1
+    has_walkforward = any(row["validated"] is not None for row in rows)
+    # Walk-forward pass is a necessary extra condition, never a substitute: a valid_negative
+    # account whose folds happen to pass is still not a success.
+    success = sum(1 for row in rows if row["category"] == "improvement" and
+                  (row["validated"] is True if has_walkforward else True))
+    return {"batches": len(directories), "decisions": len(rows), "counts": counts,
+            "success_measure": "validated" if has_walkforward else "improvement", "successes": success,
+            "no_verdict": sum(counts.get(c, 0) for c in NO_VERDICT),
+            "median_minutes_decision_to_outcome": statistics.median(minutes) if minutes else None,
+            "policies": sorted(policies), "harness_bundles": sorted(harnesses)}
+
+
+def compare(incumbent_dirs, candidate_dirs, rule=None):
+    rule = {**DEFAULT_RULE, **(rule or {})}
+    z = Z[rule["confidence"]]
+    a, b = arm_summary(incumbent_dirs), arm_summary(candidate_dirs)
+    result = {"schema": "research_online_ab.v1", "rule": rule, "incumbent": a, "candidate": b}
+    if a["success_measure"] != b["success_measure"]:
+        result["decision"] = "insufficient_data"
+        result["reason"] = "arms use different success measures; attach walk-forward verdicts to both"
+        return result
+    if min(a["decisions"], b["decisions"]) < rule["min_decisions"]:
+        result["decision"] = "insufficient_data"
+        result["reason"] = f"each arm needs at least {rule['min_decisions']} observed decisions"
+        return result
+    success = newcombe(b["successes"], b["decisions"], a["successes"], a["decisions"], z)
+    no_verdict = newcombe(b["no_verdict"], b["decisions"], a["no_verdict"], a["decisions"], z)
+    result["success_rate_difference_interval"] = success
+    result["no_verdict_rate_difference_interval"] = no_verdict
+    no_verdict_rise = b["no_verdict"] / b["decisions"] - a["no_verdict"] / a["decisions"]
+    result["no_verdict_rate_difference"] = no_verdict_rise
+    # An upper-bound guard would never pass at realistic sample sizes (with zero failures
+    # in both arms of 40, the upper bound is still 6.3%); guard on estimate plus detection.
+    if success[0] > 0 and no_verdict_rise <= rule["max_no_verdict_increase"] and no_verdict[0] <= 0:
+        result["decision"] = "prefer_candidate"
+    elif success[1] < 0:
+        result["decision"] = "prefer_incumbent"
+    else:
+        result["decision"] = "no_difference"
+    result["claims"] = "development-period research productivity only; not independent economic confirmation"
+    return result
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--incumbent", nargs="+", required=True, help="closed batch directories run with the incumbent")
+    parser.add_argument("--candidate", nargs="+", required=True, help="closed batch directories run with the candidate")
+    parser.add_argument("--rule", help="frozen JSON overriding min_decisions / confidence / max_no_verdict_increase")
+    parser.add_argument("--out")
+    args = parser.parse_args(argv)
+    try:
+        rule = read(args.rule) if args.rule else None
+        result = compare(args.incumbent, args.candidate, rule)
+        text = json.dumps(result, ensure_ascii=False, indent=2)
+        if args.out:
+            with open(args.out, "x", encoding="utf-8", newline="\n") as handle:
+                handle.write(text + "\n")
+        print(text)
+        return 0
+    except (ValueError, OSError, KeyError) as error:
+        print(json.dumps({"status": "error", "detail": str(error)}, ensure_ascii=False), file=sys.stderr)
+        return 2
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/engine/research_outcomes.py b/engine/research_outcomes.py
new file mode 100644
index 0000000..abc7e20
--- /dev/null
+++ b/engine/research_outcomes.py
@@ -0,0 +1,144 @@
+#!/usr/bin/env python3
+"""Canonical research outcome categories. Standard library only.
+
+Every research line writes its own outcome strings; the 2026-10-16 ledger holds
+hundreds of spellings per line (cautious 370, structure 262, math 122). Rates
+such as "share of decisions that produced a verdict" cannot be compared across
+batches, lines or harness versions until each record maps to one fixed category.
+
+New records should write ``outcome`` with one of CATEGORIES directly and keep
+their detailed wording in a separate field. ``classify`` maps legacy wording on a
+best-effort basis and reports ``unclassified`` instead of guessing.
+"""
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import re
+import sys
+from collections import Counter
+
+CATEGORIES = (
+    "improvement",          # frozen economic criteria passed against the frozen parent
+    "negative",             # complete, valid account result that failed its criteria
+    "risk_limit",           # complete account rejected only by the drawdown / risk cap
+    "information",          # information or engineering question answered (positive or negative)
+    "engineering_failure",  # code, data or execution error; no valid answer produced
+    "evidence_gap",         # ran or partly ran, but the verdict is unknown / unscored / inadmissible
+    "not_executed",         # prepared, withdrawn, deferred or still waiting
+    "unclassified",         # legacy wording that does not determine a category
+)
+VERDICT = {"improvement", "negative", "risk_limit", "information"}
+NO_VERDICT = {"engineering_failure", "evidence_gap"}
+
+ACCOUNT_KINDS = {"account", "group"}
+
+# Ordered (pattern, category). The first match wins; patterns see lowercase text.
+_STRONG = [
+    (r"not_executed|withdrawn|deferred|prepared_or|^prepared$|^preparation$|pending|awaiting|waiting|"
+     r"not_account_ready|under_review|input_package_gap|no_new_ready|without_admitted|no_scientific_selection|"
+     r"not_selected|running_unconfirmed|needs_independent", "not_executed"),
+    (r"implementation_(error|invalid|fail)|repairs?_exhausted|preflight_failed|execution_failed|"
+     r"execution_failure|engineering_failure|^failed$|crash|exception|semantic_qualification_error|"
+     r"implementation_budget_exhausted|bootstrap_fail|collision|guard_failure|phase_failure|"
+     r"repair_unresolved|mapping_failure", "engineering_failure"),
+    (r"risk_limit|drawdown_only|mdd_exceeded|risk_cap", "risk_limit"),
+    (r"valid_improvement|^improved$|^improvement$|return_improved|development_gate_met|economic_gate_passed|"
+     r"development_gate_pass", "improvement"),
+    (r"unscored|unknown|unverified|evidence_gap|source_evidence_gap|coverage_gap|admissib|qualification_fail|"
+     r"right_censored|censored|economics_unknown|financial_unknown|unresolved_lifecycle|incomplete_economics|"
+     r"not_admitted|unadmitted|ineligible|metadata_qualification|admission_fail|source_unknown|readiness_gap|"
+     r"coverage_failed|unaccepted|space_insufficient|not_qualified", "evidence_gap"),
+]
+# A frozen criterion that failed is a valid (negative) answer, not a missing one.
+_NEGATIVE = (r"valid_negative|^negative$|economic_failure|profit_or_drawdown|gates?_fail|failed_development_goal|"
+             r"goal_failed|reject|closed_valid_negative|negative|close_expression|dual_failed|profit_or_risk_failed|"
+             r"rejected_candidate|close_fixed|closed_fixed|fixed_direction|source_activity|coactivity|"
+             r"distinction_gate|not_supported|no_positive|stop_exact|close_exact|close_invalid")
+_ANSWERED = (r"verified|information|^pass|_pass|passed|^complete|completed|^evaluated$|recorded_result|"
+             r"result_recorded|^primary$|descriptive|delivered|method_evidence|original_verdict_recorded|"
+             r"mechanics|derivation|diagnostic|^closed?$|^closed_|^close_|^stop|^retain|^accepted|census|"
+             r"computed|^allow|explains|counterexample|discovery_only|source_lead|^finding")
+_MISSING = r"fail|truncated|incomplete|missing|gap|unproven|ambiguous|insufficient"
+_STRONG_COMPILED = [(re.compile(pattern), category) for pattern, category in _STRONG]
+
+
+def classify(status, record_kind=None):
+    """Map one legacy outcome string (plus optional record kind) to a canonical category.
+
+    Information-stage records answer questions even when the answer is negative,
+    so their negatives count as ``information``. Account records that only say
+    "completed" or "recorded" do not reveal the verdict and stay ``unclassified``.
+    """
+    text = (status or "").strip().lower()
+    if not text:
+        return "unclassified"
+    if text in CATEGORIES:
+        return text
+    kind = (record_kind or "").strip().lower()
+    account = kind in ACCOUNT_KINDS
+    for pattern, category in _STRONG_COMPILED:
+        if pattern.search(text):
+            return "information" if category == "risk_limit" and kind and not account else category
+    if re.search(_NEGATIVE, text):
+        return "negative" if account or not kind else "information"
+    if account:
+        # "completed" or "recorded" on an account record does not reveal the economic verdict.
+        if re.search(r"verified_information|mechanics", text):
+            return "information"
+        return "evidence_gap" if re.search(_MISSING, text) else "unclassified"
+    if re.search(_MISSING, text):
+        return "evidence_gap"
+    if re.search(_ANSWERED, text):
+        return "information"
+    return "unclassified"
+
+
+def summarize(rows):
+    """rows: iterable of (status, record_kind). Returns counts and verdict / no-verdict shares."""
+    counts = Counter(classify(status, kind) for status, kind in rows)
+    total = sum(counts.values())
+    verdict = sum(counts[c] for c in VERDICT)
+    missing = sum(counts[c] for c in NO_VERDICT)
+    return {"total": total, "counts": {c: counts.get(c, 0) for c in CATEGORIES},
+            "verdict_share": verdict / total if total else None,
+            "no_verdict_share": missing / total if total else None,
+            "unclassified_share": counts.get("unclassified", 0) / total if total else None}
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    sub = parser.add_subparsers(dest="command", required=True)
+    one = sub.add_parser("classify", help="classify one status string")
+    one.add_argument("status")
+    one.add_argument("--kind")
+    table = sub.add_parser("ledger", help="summarize a CSV ledger by line")
+    table.add_argument("--csv", required=True)
+    table.add_argument("--status-column", default="result_classification")
+    table.add_argument("--kind-column", default="record_kind")
+    table.add_argument("--line-column", default="research_line")
+    table.add_argument("--show-unclassified", type=int, default=0)
+    args = parser.parse_args(argv)
+    if args.command == "classify":
+        print(json.dumps({"status": args.status, "category": classify(args.status, args.kind)}, ensure_ascii=False))
+        return 0
+    csv.field_size_limit(10 ** 9)
+    by_line, unclassified = {}, Counter()
+    with open(args.csv, encoding="utf-8-sig", newline="") as handle:
+        for row in csv.DictReader(handle):
+            status, kind = row.get(args.status_column, ""), row.get(args.kind_column, "")
+            by_line.setdefault(row.get(args.line_column, ""), []).append((status, kind))
+            if classify(status, kind) == "unclassified":
+                unclassified[(status, kind)] += 1
+    report = {line: summarize(rows) for line, rows in sorted(by_line.items())}
+    report["_all"] = summarize([pair for rows in by_line.values() for pair in rows])
+    if args.show_unclassified:
+        report["_unclassified_examples"] = [{"status": s, "kind": k, "rows": n}
+                                            for (s, k), n in unclassified.most_common(args.show_unclassified)]
+    print(json.dumps(report, ensure_ascii=False, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/engine/research_timing.py b/engine/research_timing.py
new file mode 100644
index 0000000..1b4f862
--- /dev/null
+++ b/engine/research_timing.py
@@ -0,0 +1,198 @@
+#!/usr/bin/env python3
+"""Phase timers that produce research_cost_receipt.v1 inputs. Standard library only.
+
+The 2026-10-16 audit found compute end times on 139 of 4,137 ledger rows and at
+least one null cost field in all 1,277 method reports. Costs were written by hand
+after the fact, so they were mostly missing, and a missing cost blocked every
+method comparison. This tool records time where the work happens:
+
+  run     wraps an executor command and records start, end, exit code and seconds
+  start   / stop  bracket Agent work that is not a subprocess (generation, review)
+  receipt assembles the five-phase research_cost_receipt.v1 for one decision
+
+Every timer file is written once. ``seconds`` is the field cost receipts read
+(``seconds_path: "seconds"``). Two events on the same resource may not overlap,
+so a wrapper around a wrapper cannot count the same minutes twice.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import socket
+import subprocess
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+PHASES = ("generation", "execution", "verification", "maintenance", "communication")
+DEFAULT_RESOURCE = {"generation": "agent", "communication": "agent", "maintenance": "agent",
+                    "execution": "compute", "verification": "compute"}
+
+
+def now():
+    return datetime.now(timezone.utc)
+
+
+def reference(path):
+    path = Path(path).resolve()
+    return {"path": str(path), "sha256": hashlib.sha256(path.read_bytes()).hexdigest()}
+
+
+def write_once(path, value):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("x", encoding="utf-8", newline="\n") as handle:
+        json.dump(value, handle, ensure_ascii=False, indent=2, allow_nan=False)
+        handle.write("\n")
+    return reference(path)
+
+
+def check_identity(event_id, phase, resource):
+    if not event_id or not isinstance(event_id, str):
+        raise ValueError("event id required")
+    if phase not in PHASES:
+        raise ValueError("phase must be one of " + ", ".join(PHASES))
+    return resource or DEFAULT_RESOURCE[phase]
+
+
+def record(event_id, phase, resource, started, finished, command=None, exit_code=None, note=None):
+    seconds = (finished - started).total_seconds()
+    if seconds < 0:
+        raise ValueError("timer stopped before it started")
+    return {"schema": "research_timing.v1", "event_id": event_id, "phase": phase, "resource": resource,
+            "started_at": started.isoformat(), "finished_at": finished.isoformat(), "seconds": seconds,
+            "command": command, "exit_code": exit_code, "host": socket.gethostname(), "pid": os.getpid(),
+            "note": note, "accounting": "wall time of this event on its resource; not a wait or a total"}
+
+
+def run(event_id, phase, out, command, resource=None, note=None):
+    """Run a command and record its time; the command's exit code is returned unchanged."""
+    resource = check_identity(event_id, phase, resource)
+    if not command:
+        raise ValueError("command required after --")
+    if Path(out).exists():
+        raise ValueError("timer file already exists; use a new event id")
+    started = now()
+    completed = subprocess.run(command)
+    finished = now()
+    write_once(out, record(event_id, phase, resource, started, finished, command, completed.returncode, note))
+    return completed.returncode
+
+
+def start(event_id, phase, out, resource=None, note=None):
+    resource = check_identity(event_id, phase, resource)
+    value = {"schema": "research_timing_start.v1", "event_id": event_id, "phase": phase,
+             "resource": resource, "started_at": now().isoformat(), "note": note}
+    return write_once(out, value)
+
+
+def stop(start_path, out, note=None):
+    begun = json.loads(Path(start_path).read_text(encoding="utf-8"))
+    if begun.get("schema") != "research_timing_start.v1":
+        raise ValueError("not a timer start file")
+    started = datetime.fromisoformat(begun["started_at"])
+    value = record(begun["event_id"], begun["phase"], begun["resource"], started, now(),
+                   note=note or begun.get("note"))
+    value["start_file"] = reference(start_path)
+    return write_once(out, value)
+
+
+def overlapping(events):
+    """Pairs of events on one resource whose intervals overlap."""
+    clashes = []
+    by_resource = {}
+    for event in events:
+        by_resource.setdefault(event["resource"], []).append(event)
+    for resource, items in by_resource.items():
+        items.sort(key=lambda e: e["started_at"])
+        for left, right in zip(items, items[1:]):
+            if datetime.fromisoformat(right["started_at"]) < datetime.fromisoformat(left["finished_at"]):
+                clashes.append((resource, left["event_id"], right["event_id"]))
+    return clashes
+
+
+def receipt(cost_contract, subject, timers, out, kind="decision", none_phases=()):
+    """Assemble research_cost_receipt.v1. Phases without timers stay null (unknown).
+
+    ``none_phases`` lists phases the caller states had no activity at all; they are
+    written as [] (measured zero), which is different from null (not measured).
+    """
+    events = []
+    for path in timers:
+        value = json.loads(Path(path).read_text(encoding="utf-8"))
+        if value.get("schema") != "research_timing.v1":
+            raise ValueError(f"{path}: not a finished timer")
+        events.append({**value, "_path": path})
+    ids = [e["event_id"] for e in events]
+    if len(ids) != len(set(ids)):
+        raise ValueError("duplicate event id across timers")
+    clashes = overlapping(events)
+    if clashes:
+        raise ValueError("overlapping timers on one resource would double count: " + repr(clashes))
+    phases = {phase: None for phase in PHASES}
+    for phase in none_phases:
+        if phase not in PHASES:
+            raise ValueError("unknown phase " + phase)
+        phases[phase] = []
+    for event in events:
+        if phases[event["phase"]] is None:
+            phases[event["phase"]] = []
+        if event["phase"] in none_phases:
+            raise ValueError(f"phase {event['phase']} declared empty but has a timer")
+        phases[event["phase"]].append({"id": event["event_id"], "evidence": reference(event["_path"]),
+                                       "seconds_path": "seconds"})
+    value = {"schema": "research_cost_receipt.v1", "cost_contract": reference(cost_contract),
+             "kind": kind, "subject": reference(subject), "phases": phases}
+    return write_once(out, value)
+
+
+def main(argv=None):
+    argv = list(sys.argv[1:] if argv is None else argv)
+    command = []
+    if "--" in argv:
+        split = argv.index("--")
+        argv, command = argv[:split], argv[split + 1:]
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = parser.add_subparsers(dest="command", required=True)
+    p = sub.add_parser("run", help="time one executor command: run ... -- <command>")
+    for name in ("--event-id", "--phase", "--out"):
+        p.add_argument(name, required=True)
+    p.add_argument("--resource")
+    p.add_argument("--note")
+    p = sub.add_parser("start", help="open a timer for non-subprocess work")
+    for name in ("--event-id", "--phase", "--out"):
+        p.add_argument(name, required=True)
+    p.add_argument("--resource")
+    p.add_argument("--note")
+    p = sub.add_parser("stop", help="close a timer opened with start")
+    p.add_argument("--start", required=True)
+    p.add_argument("--out", required=True)
+    p.add_argument("--note")
+    p = sub.add_parser("receipt", help="assemble a five-phase cost receipt")
+    p.add_argument("--cost-contract", required=True)
+    p.add_argument("--subject", required=True, help="the D*.json decision (or REPORT / TASK) this cost belongs to")
+    p.add_argument("--timer", action="append", default=[])
+    p.add_argument("--none", action="append", default=[], help="phase with no activity at all (written as [])")
+    p.add_argument("--kind", default="decision")
+    p.add_argument("--out", required=True)
+    args = parser.parse_args(argv)
+    try:
+        if args.command == "run":
+            return run(args.event_id, args.phase, args.out, command, args.resource, args.note)
+        if args.command == "start":
+            result = start(args.event_id, args.phase, args.out, args.resource, args.note)
+        elif args.command == "stop":
+            result = stop(args.start, args.out, args.note)
+        else:
+            result = receipt(args.cost_contract, args.subject, args.timer, args.out, args.kind, args.none)
+        print(json.dumps(result, ensure_ascii=False))
+        return 0
+    except (ValueError, OSError, KeyError) as error:
+        print(json.dumps({"status": "error", "detail": str(error)}, ensure_ascii=False), file=sys.stderr)
+        return 2
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/engine/research_walkforward.py b/engine/research_walkforward.py
new file mode 100644
index 0000000..c5ca1ca
--- /dev/null
+++ b/engine/research_walkforward.py
@@ -0,0 +1,259 @@
+#!/usr/bin/env python3
+"""Walk-forward verdicts on a candidate and its parent. Standard library only.
+
+Why: about 1,100 account candidates were ranked on the same 2020-2025 window.
+Structure line accounts have a median 275% annualized return (max 336%); ML3's
+median is 299% against a 316% baseline. The only true out-of-sample run, ML2 on
+2026-01-05..2026-09-30 (181 trading days, native), returned 57.6% annualized for
+E1002J (306% in development) and 91.2% for H543 (294% in development). Beating
+the parent again on the window that produced the parent mostly selects noise.
+
+This scorer splits one continuous account into a visible window and later
+validation folds. Only the visible window is reported in full; the folds decide,
+and by default the researcher-facing verdict shows each fold only as pass/fail
+plus a coarse delta bucket, so validation numbers cannot be tuned against. Folds
+may not overlap the visible window or each other (differencing overlapping
+windows would reveal the masked numbers). Rows on or after the seal date are
+never read.
+
+Input equity: JSON list of {"date": "YYYY-MM-DD", "equity": number}, a JSON
+object with such a list under "equity_curve" / "daily" / "series", or a CSV with
+date and equity columns. Annualization uses 250 trading days, as the project does.
+"""
+from __future__ import annotations
+
+import argparse
+import csv
+import hashlib
+import json
+import math
+import sys
+from datetime import date
+from pathlib import Path
+
+SCHEMA = "research_walkforward.v1"
+DEFAULT_CONTRACT = {
+    "schema": SCHEMA,
+    # The only window whose numbers the researcher sees in full.
+    "visible": ["2020-01-01", "2022-12-31"],
+    # Each later year is a validation fold reported as pass/fail plus a coarse bucket.
+    "folds": [
+        {"id": "V2023", "window": ["2023-01-01", "2023-12-31"]},
+        {"id": "V2024", "window": ["2024-01-01", "2024-12-31"]},
+        {"id": "V2025", "window": ["2025-01-01", "2025-12-31"]},
+    ],
+    "seal_start": "2026-01-01",
+    "min_fold_wins": 2,
+    "min_mean_delta_pp": 0.0,
+    "max_validation_mdd_pct": 20.0,
+    "annualization_days": 250,
+    "min_rows_per_window": 60,
+    # Rows per weekday in each window. A-share years trade about 242 of about 261 weekdays (0.93);
+    # a candidate that keeps only some rows would otherwise annualize the same growth over fewer days.
+    "min_calendar_coverage": 0.85,
+    "mask_validation": True,
+}
+BUCKETS = ((-math.inf, -10, "<-10pp"), (-10, -2, "-10..-2pp"), (-2, 2, "-2..+2pp"),
+           (2, 10, "+2..+10pp"), (10, math.inf, ">+10pp"))
+
+
+def day(value):
+    return date.fromisoformat(str(value)[:10])
+
+
+def reference(path):
+    path = Path(path).resolve()
+    return {"path": str(path), "sha256": hashlib.sha256(path.read_bytes()).hexdigest()}
+
+
+def validate_contract(contract):
+    if contract.get("schema") != SCHEMA:
+        raise ValueError("walk-forward contract schema mismatch")
+    seal = day(contract["seal_start"])
+    v0, v1 = map(day, contract["visible"])
+    folds = contract["folds"]
+    if not folds or len({f["id"] for f in folds}) != len(folds):
+        raise ValueError("folds must be non-empty with unique ids")
+    previous_end = v1
+    if not v0 <= v1:
+        raise ValueError("visible window is empty")
+    for fold in folds:
+        f0, f1 = map(day, fold["window"])
+        # Folds must follow the visible window and each other; any overlap would let
+        # the full visible numbers, or one fold's bucket, reveal another fold.
+        if not (previous_end < f0 <= f1):
+            raise ValueError(f"{fold['id']}: folds must be ordered, non-overlapping and after the visible window")
+        if f1 >= seal:
+            raise ValueError(f"{fold['id']}: validation touches the sealed period")
+        previous_end = f1
+    if not 1 <= contract["min_fold_wins"] <= len(folds):
+        raise ValueError("min_fold_wins outside fold count")
+    if not 0 <= contract.get("min_calendar_coverage", 0.85) <= 1:
+        raise ValueError("min_calendar_coverage must be within 0..1")
+    return contract
+
+
+def load_equity(path, seal):
+    """Sorted (date, equity) rows strictly before the seal; returns rows and sealed count."""
+    path = Path(path)
+    text = path.read_text(encoding="utf-8-sig")
+    rows = []
+    if path.suffix.lower() == ".csv":
+        reader = csv.DictReader(text.splitlines())
+        fields = {name.lower(): name for name in reader.fieldnames or []}
+        date_key = next((fields[k] for k in ("date", "day", "trade_date") if k in fields), None)
+        value_key = next((fields[k] for k in ("equity", "total_value", "value", "nav") if k in fields), None)
+        if not date_key or not value_key:
+            raise ValueError(f"{path}: need date and equity columns")
+        rows = [(day(r[date_key]), float(r[value_key])) for r in reader if r[value_key] not in ("", None)]
+    else:
+        data = json.loads(text)
+        if isinstance(data, dict):
+            data = next((data[k] for k in ("equity_curve", "daily", "series", "equity") if k in data), None)
+        if not isinstance(data, list):
+            raise ValueError(f"{path}: no equity list found")
+        for item in data:
+            if isinstance(item, dict):
+                rows.append((day(item["date"]), float(item.get("equity", item.get("value")))))
+            else:
+                rows.append((day(item[0]), float(item[1])))
+    rows.sort()
+    if len({d for d, _ in rows}) != len(rows):
+        raise ValueError(f"{path}: duplicate dates")
+    if any(not math.isfinite(v) or v <= 0 for _, v in rows):
+        raise ValueError(f"{path}: equity must be positive and finite")
+    kept = [r for r in rows if r[0] < seal]
+    return kept, len(rows) - len(kept)
+
+
+def weekdays(start, end):
+    count, d = 0, start
+    while d <= end:
+        count += d.weekday() < 5
+        d = date.fromordinal(d.toordinal() + 1)
+    return count
+
+
+def window_metrics(rows, start, end, days, min_rows, min_coverage=0.0):
+    """Annualized return and max drawdown of one window, rebased on the prior close."""
+    start, end = day(start), day(end)
+    inside = [(d, v) for d, v in rows if start <= d <= end]
+    coverage = len(inside) / max(1, weekdays(start, end))
+    if len(inside) < min_rows:
+        return {"rows": len(inside), "annual_return_pct": None, "mdd_pct": None, "status": "insufficient_rows",
+                "calendar_coverage": coverage}
+    if coverage < min_coverage:
+        return {"rows": len(inside), "annual_return_pct": None, "mdd_pct": None, "status": "calendar_gap",
+                "calendar_coverage": coverage}
+    before = [v for d, v in rows if d < start]
+    base = before[-1] if before else inside[0][1]
+    periods = len(inside) if before else len(inside) - 1
+    growth = inside[-1][1] / base
+    annual = (growth ** (days / periods) - 1) * 100 if periods > 0 else None
+    peak, worst = base, 0.0
+    for _, value in inside:
+        peak = max(peak, value)
+        worst = max(worst, 1 - value / peak)
+    return {"rows": len(inside), "annual_return_pct": annual, "mdd_pct": worst * 100,
+            "total_return_pct": (growth - 1) * 100, "status": "ok", "calendar_coverage": coverage}
+
+
+def bucket(delta):
+    return next(label for low, high, label in BUCKETS if low <= delta < high)
+
+
+def evaluate(contract, candidate_path, parent_path):
+    contract = validate_contract(contract)
+    seal = day(contract["seal_start"])
+    cand, cand_sealed = load_equity(candidate_path, seal)
+    par, par_sealed = load_equity(parent_path, seal)
+    # Both arms must be scored on one trading calendar; otherwise dropping rows from the
+    # candidate (or the parent) changes its annualization and can manufacture fold wins.
+    only_cand = sorted({d for d, _ in cand} - {d for d, _ in par})
+    only_par = sorted({d for d, _ in par} - {d for d, _ in cand})
+    if only_cand or only_par:
+        raise ValueError(f"candidate and parent calendars differ: {len(only_cand)} dates only in candidate, "
+                         f"{len(only_par)} only in parent (first: {(only_cand or only_par)[0]})")
+    days, min_rows = contract["annualization_days"], contract["min_rows_per_window"]
+    coverage = contract.get("min_calendar_coverage", 0.85)
+    visible = {"window": contract["visible"],
+               "candidate": window_metrics(cand, *contract["visible"], days, min_rows, coverage),
+               "parent": window_metrics(par, *contract["visible"], days, min_rows, coverage)}
+    folds, wins, deltas, mdd_ok, complete = [], 0, [], True, True
+    for fold in contract["folds"]:
+        val_c = window_metrics(cand, *fold["window"], days, min_rows, coverage)
+        val_p = window_metrics(par, *fold["window"], days, min_rows, coverage)
+        known = val_c["status"] == val_p["status"] == "ok"
+        delta = val_c["annual_return_pct"] - val_p["annual_return_pct"] if known else None
+        fold_mdd_ok = known and val_c["mdd_pct"] <= contract["max_validation_mdd_pct"]
+        win = bool(known and delta > 0 and fold_mdd_ok)
+        complete &= known
+        mdd_ok &= bool(fold_mdd_ok)
+        wins += win
+        if known:
+            deltas.append(delta)
+        folds.append({"id": fold["id"], "window": fold["window"], "candidate": val_c, "parent": val_p,
+                      "delta_pp": delta, "win": win, "mdd_ok": bool(fold_mdd_ok)})
+    mean_delta = sum(deltas) / len(deltas) if deltas else None
+    passed = (complete and wins >= contract["min_fold_wins"] and mdd_ok and
+              mean_delta is not None and mean_delta >= contract["min_mean_delta_pp"])
+    decision = "pass" if passed else ("insufficient_data" if not complete else "fail")
+    return {"schema": "research_walkforward_verdict.v1", "contract": contract, "decision": decision,
+            "fold_wins": wins, "folds_required": contract["min_fold_wins"], "mean_validation_delta_pp": mean_delta,
+            "validation_mdd_ok": mdd_ok, "visible": visible, "folds": folds,
+            "candidate": reference(candidate_path), "parent": reference(parent_path),
+            "sealed_rows_ignored": {"candidate": cand_sealed, "parent": par_sealed},
+            "scope": "development-period walk-forward; not independent confirmation; 2026 stays sealed"}
+
+
+def masked(verdict):
+    """Researcher-facing copy: the visible window in full, each fold only as pass/fail and bucket."""
+    view = {k: v for k, v in verdict.items() if k not in {"folds", "mean_validation_delta_pp"}}
+    view["folds"] = [{"id": fold["id"], "window": fold["window"], "win": fold["win"], "mdd_ok": fold["mdd_ok"],
+                      "delta_bucket": bucket(fold["delta_pp"]) if fold["delta_pp"] is not None else None}
+                     for fold in verdict["folds"]]
+    view["mean_validation_delta_bucket"] = (bucket(verdict["mean_validation_delta_pp"])
+                                            if verdict["mean_validation_delta_pp"] is not None else None)
+    view["masked"] = True
+    return view
+
+
+def write_once(path, value):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("x", encoding="utf-8", newline="\n") as handle:
+        json.dump(value, handle, ensure_ascii=False, indent=2, allow_nan=False)
+        handle.write("\n")
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = parser.add_subparsers(dest="command", required=True)
+    sub.add_parser("default-contract", help="print the default contract: visible 2020-2022, folds 2023/2024/2025")
+    p = sub.add_parser("evaluate", help="score a candidate against its parent")
+    p.add_argument("--contract", help="frozen contract JSON; default visible 2020-2022, folds 2023/2024/2025")
+    p.add_argument("--candidate", required=True, help="candidate daily equity (JSON or CSV)")
+    p.add_argument("--parent", required=True, help="parent daily equity on the same account rules")
+    p.add_argument("--out", required=True, help="researcher-facing verdict (masked unless the contract says no)")
+    p.add_argument("--detail-out", help="full numbers for the controller; keep outside the Agent's reading path")
+    args = parser.parse_args(argv)
+    try:
+        if args.command == "default-contract":
+            print(json.dumps(DEFAULT_CONTRACT, ensure_ascii=False, indent=2))
+            return 0
+        contract = json.loads(Path(args.contract).read_text(encoding="utf-8-sig")) if args.contract else DEFAULT_CONTRACT
+        verdict = evaluate(contract, args.candidate, args.parent)
+        if args.detail_out:
+            write_once(args.detail_out, verdict)
+        public = masked(verdict) if contract.get("mask_validation", True) else verdict
+        write_once(args.out, public)
+        print(json.dumps({"decision": verdict["decision"], "fold_wins": verdict["fold_wins"],
+                          "out": str(Path(args.out).resolve())}, ensure_ascii=False))
+        return 0
+    except (ValueError, OSError, KeyError) as error:
+        print(json.dumps({"status": "error", "detail": str(error)}, ensure_ascii=False), file=sys.stderr)
+        return 2
+
+
+if __name__ == "__main__":
+    sys.exit(main())
